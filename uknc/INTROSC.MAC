; INTROSC.MAC - generated by tools/mkintro.py from INTRO.TXT.  Do not edit.
; One zero-terminated string per screen, for the 80x24 text screen.

INTR1:
	.BYTE	33,240,66		; title in yellow
	.ASCII	/          S T R A T E G O/
	.BYTE	33,240,67		; back to white
	.BYTE	15,12,12
	.ASCII	/    June 18, 1815 - Waterloo/<15><12>
	.BYTE	12
	.ASCII	/Napoleon has escaped from exile and marches on the British and/<15><12>
	.ASCII	/Prussian army of the Duke of Wellington./<15><12>
	.ASCII	/They meet near the town of Waterloo./<15><12>
	.ASCII	/The fate of Europe depends on the battle./<15><12>
	.BYTE	12
	.ASCII	/The computer is Wellington, the RED army./<15><12>
	.ASCII	/You are Napoleon, the BLUE army, at the bottom of the board./<15><12>
	.BYTE	12
	.ASCII	/GOAL: capture the enemy flag./<15><12>
	.BYTE	12
	.ASCII	|Game AI based on BASIC code for TI-99/4A|<15><12>
	.ASCII	/by Walid Maalouli/<15><12>
	.ASCII	/UKNC version: Nikita Zimin/<15><12>
	.BYTE	12
	.ASCIZ	/        Press any key/
INTR2:
	.ASCII	/ARMY (40 pieces each side):/<15><12>
	.ASCII	/M Marshal 1  9 General 1  8 Colonel 2/<15><12>
	.ASCII	/7 Major 3    6 Captain 4  5 Lieut. 4/<15><12>
	.ASCII	/4 Sergeant 4 3 Miner 5    2 Scout 8/<15><12>
	.ASCII	/S Spy 1      B Bomb 6     F Flag 1/<15><12>
	.ASCII	/A higher number is a stronger piece./<15><12>
	.BYTE	12
	.ASCII	/MOVES  Red moves first, then you./<15><12>
	.ASCII	/One piece, one square: forward, back or sideways - no diagonals,/<15><12>
	.ASCII	/no lakes. Scouts (2) go any distance in a straight line over/<15><12>
	.ASCII	/empty squares. Bombs and the Flag never move./<15><12>
	.BYTE	12
	.ASCII	/BATTLE  Move onto an enemy piece to attack. The higher rank/<15><12>
	.ASCII	/wins, the other is lost. Equal ranks: both lost./<15><12>
	.ASCII	/The Spy beats the Marshal only when the Spy attacks./<15><12>
	.ASCII	/A Miner defuses a Bomb; any other attacker is lost./<15><12>
	.BYTE	12
	.ASCII	/You win by taking the enemy Flag or leaving it with no movable/<15><12>
	.ASCII	/piece./<15><12>
	.BYTE	0
INTR3:
	.ASCII	/CONTROLS/<15><12>
	.ASCII	/To move, type four keys (no Enter): from column, from row,/<15><12>
	.ASCII	/to column, to row. Example: A6A5 moves the piece on A6 to A5./<15><12>
	.ASCII	/Columns are the letters under the board, rows the digits/<15><12>
	.ASCII	/at its left./<15><12>
	.BYTE	12
	.ASCII	/R  resign/<15><12>
	.ASCII	/N  new game/<15><12>
	.ASCII	/X  exit to RT-11/<15><12>
	.BYTE	12
	.ASCII	/SCREEN/<15><12>
	.ASCII	/Blue pieces show their rank./<15><12>
	.ASCII	/[]  hidden red piece./<15><12>
	.ASCII	/ *  means the computer has found it out./<15><12>
	.ASCII	/..  empty/<15><12>
	.ASCII	/~~  lake/<15><12>
	.ASCII	/Right: pieces left, totals, move number./<15><12>
	.ASCII	/Below: last 6 moves./<15><12>
	.BYTE	12
	.ASCII	/Your army is placed at random./<15><12>
	.BYTE	12
	.ASCIZ	/        Press any key to play /
	.EVEN
